{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tutor-project",
  "main": "src/server.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "TutorAgent", "class_name": "TutorAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TutorAgent"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutor-db",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "TUTOR_BUCKET", "bucket_name": "tutor-project-bucket" }],
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
